  "item": [
    {
      "name": "User Authentication",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@mail.ru\", \"password\": \"1234\"}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var response = pm.response.json();",
              "if (response.token) {",
              "    pm.globals.set(\"auth_token\", response.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
